rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsStore(storeId) { return signedIn() && request.auth.uid == storeId; }

    // ADMIN ACCESS
    // An admin is a signed-in user who has a document at admins/{their uid}.
    // That document can only be created in the Firebase console, never from the app.
    // There is NO rule that lets an admin read stores/{storeId}/... so an admin can never
    // read a shop's sales, customers, credit or products. Admins see only the shop-level
    // totals in shopStats and the billing records in subscriptions.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A shop whose subscription is deactivated, or whose paid-up date has passed, cannot record new sales.
    // A shop with no subscription document is NOT suspended, so existing shops keep working.
    function subscriptionPath(storeId) {
      return /databases/$(database)/documents/subscriptions/$(storeId);
    }
    function isSuspended(storeId) {
      return exists(subscriptionPath(storeId))
        && (get(subscriptionPath(storeId)).data.get('status', 'active') == 'deactivated'
          || get(subscriptionPath(storeId)).data.get('accessUntil', request.time) < request.time);
    }

    // ---- Validation helpers ----
    function numberField(d, key) {
      return d.get(key, 0) is number && d.get(key, 0) >= 0;
    }

    function validShopStats(storeId, d) {
      return d.keys().hasOnly([
          'storeId', 'shopName', 'contactEmail', 'contactPhone',
          'revenue30d', 'revenuePrev30d', 'profit30d', 'salesCount30d', 'itemsSold30d',
          'activeDays30d', 'creditSales30d', 'lastSaleAt',
          'productCount', 'lowStockCount', 'outOfStockCount', 'stockCostValue',
          'creditCustomers', 'creditOutstanding', 'creditOverdue', 'updatedAt'
        ])
        && d.keys().hasAll(['storeId', 'shopName', 'updatedAt'])
        && d.storeId == storeId
        && d.shopName is string && d.shopName.size() <= 80
        && d.get('contactEmail', '') is string && d.get('contactEmail', '').size() <= 120
        && d.get('contactPhone', '') is string && d.get('contactPhone', '').size() <= 30
        && numberField(d, 'revenue30d') && numberField(d, 'revenuePrev30d')
        && d.get('profit30d', 0) is number
        && numberField(d, 'salesCount30d') && numberField(d, 'itemsSold30d')
        && numberField(d, 'activeDays30d') && d.get('activeDays30d', 0) <= 31
        && numberField(d, 'creditSales30d')
        && (d.get('lastSaleAt', null) == null || d.get('lastSaleAt', null) is timestamp)
        && numberField(d, 'productCount') && numberField(d, 'lowStockCount')
        && numberField(d, 'outOfStockCount') && numberField(d, 'stockCostValue')
        && numberField(d, 'creditCustomers') && numberField(d, 'creditOutstanding')
        && numberField(d, 'creditOverdue')
        && d.updatedAt == request.time;
    }

    function validSubscription(storeId, d) {
      return d.keys().hasOnly([
          'storeId', 'plan', 'monthlyFee', 'status', 'coveredMonth', 'dueDate', 'accessUntil',
          'lastPaymentAt', 'lastPaymentAmount', 'deactivatedReason', 'updatedAt'
        ])
        && d.keys().hasAll(['storeId', 'plan', 'monthlyFee', 'status', 'updatedAt'])
        && d.storeId == storeId
        && d.plan is string && d.plan.size() <= 40
        && d.monthlyFee is number && d.monthlyFee >= 0
        && d.status in ['active', 'deactivated']
        && d.get('coveredMonth', '2000-01') is string
        && (d.get('dueDate', null) == null || d.get('dueDate', null) is timestamp)
        && (d.get('accessUntil', null) == null || d.get('accessUntil', null) is timestamp)
        && d.get('lastPaymentAmount', 0) is number
        && d.get('deactivatedReason', '') is string && d.get('deactivatedReason', '').size() <= 120
        && d.updatedAt == request.time;
    }

    function validPayment(d) {
      return d.keys().hasOnly(['amount', 'coveredMonth', 'paidAt', 'note', 'recordedBy'])
        &&