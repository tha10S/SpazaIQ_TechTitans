rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsStore(storeId) {
      return signedIn() && request.auth.uid == storeId;
    }

    // ADMIN ACCESS
    // An admin is a signed-in user with a document at admins/{their uid}.
    // Admin documents can only be created through the Firebase console.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Subscription suspension
    function subscriptionPath(storeId) {
      return /databases/$(database)/documents/subscriptions/$(storeId);
    }

    function isSuspended(storeId) {
      return exists(subscriptionPath(storeId))
        && (
          get(subscriptionPath(storeId)).data.get('status', 'active') == 'deactivated'
          || get(subscriptionPath(storeId)).data.get('accessUntil', request.time) < request.time
        );
    }

    // Validation helpers
    function numberField(d, key) {
      return d.get(key, 0) is number
        && d.get(key, 0) >= 0;
    }

    // Shop-level totals
    function validShopStats(storeId, d) {
      return d.keys().hasOnly([
          'storeId', 'shopName', 'contactEmail', 'contactPhone',
          'revenue30d', 'revenuePrev30d', 'profit30d', 'salesCount30d', 'itemsSold30d',
          'activeDays30d', 'creditSales30d', 'lastSaleAt', 'firstSaleAt',
          'weekRevenue1', 'weekRevenue2', 'weekRevenue3', 'weekRevenue4',
          'productCount', 'lowStockCount', 'outOfStockCount', 'stockCostValue',
          'stockGapSalesShare', 'expiryTrackedShare', 'expiredValue', 'expiringSoonValue',
          'expiryTrackedCount', 'expiredCount', 'expiringSoonCount',
          'creditCustomers', 'creditOutstanding', 'creditOverdue',
          'creditDueCount90d', 'creditOnTimeCount90d', 'creditDueAmount90d', 'creditOnTimeAmount90d',
          'updatedAt'
        ])
        && d.keys().hasAll(['storeId', 'shopName', 'updatedAt'])
        && d.storeId == storeId
        && d.shopName is string
        && d.shopName.size() <= 80
        && d.get('contactEmail', '') is string
        && d.get('contactEmail', '').size() <= 120
        && d.get('contactPhone', '') is string
        && d.get('contactPhone', '').size() <= 30
        && numberField(d, 'revenue30d')
        && numberField(d, 'revenuePrev30d')
        && d.get('profit30d', 0) is number
        && numberField(d, 'salesCount30d')
        && numberField(d, 'itemsSold30d')
        && numberField(d, 'activeDays30d')
        && d.get('activeDays30d', 0) <= 31
        && numberField(d, 'creditSales30d')
        && (d.get('lastSaleAt', null) == null || d.get('lastSaleAt', null) is timestamp)
        && (d.get('firstSaleAt', null) == null || d.get('firstSaleAt', null) is timestamp)
        && numberField(d, 'weekRevenue1')
        && numberField(d, 'weekRevenue2')
        && numberField(d, 'weekRevenue3')
        && numberField(d, 'weekRevenue4')
        && numberField(d, 'productCount')
        && numberField(d, 'lowStockCount')
        && numberField(d, 'outOfStockCount')
        && numberField(d, 'stockCostValue')
        && numberField(d, 'stockGapSalesShare')
        && d.get('stockGapSalesShare', 0) <= 1
        && numberField(d, 'expiryTrackedShare')
        && d.get('expiryTrackedShare', 0) <= 1
        && numberField(d, 'expiredValue')
        && numberField(d, 'expiringSoonValue')
        && numberField(d, 'expiryTrackedCount')
        && numberField(d, 'expiredCount')
        && numberField(d, 'expiringSoonCount')
        && numberField(d, 'creditCustomers')
        && numberField(d, 'creditOutstanding')
        && numberField(d, 'creditOverdue')
        && numberField(d, 'creditDueCount90d')
        && numberField(d, 'creditOnTimeCount90d')
        && d.get('creditOnTimeCount90d', 0) <= d.get('creditDueCount90d', 0)
        && numberField(d, 'creditDueAmount90d')
        && numberField(d, 'creditOnTimeAmount90d')
        && d.get('creditOnTimeAmount90d', 0) <= d.get('creditDueAmount90d', 0) + 1
        && d.updatedAt == request.time;
    }

    function validSubscription(storeId, d) {
      return d.keys().hasOnly([
          'storeId', 'plan', 'monthlyFee', 'status', 'coveredMonth', 'dueDate', 'accessUntil',
          'lastPaymentAt', 'lastPaymentAmount', 'deactivatedReason', 'updatedAt'
        ])
        && d.keys().hasAll(['storeId', 'plan', 'monthlyFee', 'status', 'updatedAt'])
        && d.storeId == storeId
        && d.plan is string
        && d.plan.size() <= 40
        && d.monthlyFee is number
        && d.monthlyFee >= 0
        && d.status in ['active', 'deactivated']
        && d.get('coveredMonth', '2000-01') is string
        && (d.get('dueDate', null) == null || d.get('dueDate', null) is timestamp)
        && (d.get('accessUntil', null) == null || d.get('accessUntil', null) is timestamp)
        && d.get('lastPaymentAmount', 0) is number
        && d.get('deactivatedReason', '') is string
        && d.get('deactivatedReason', '').size() <= 120
        && d.updatedAt == request.time;
    }

    function validPayment(d) {
      return d.keys().hasOnly([
          'amount', 'coveredMonth', 'paidAt', 'note', 'recordedBy'
        ])
        && d.keys().hasAll([
          'amount', 'coveredMonth', 'paidAt', 'recordedBy'
        ])
        && d.amount is number
        && d.amount >= 0
        && d.coveredMonth is string
        && d.coveredMonth.size() == 7
        && d.get('note', '') is string
        && d.get('note', '').size() <= 200
        && d.recordedBy == request.auth.uid
        && d.paidAt == request.time;
    }

    // DEMO ONLY: SIMULATED SUBSCRIPTION PAYMENT
    // There is no payment server yet, so the shop's own app marks its subscription as paid. This trusts the app.
    // REMOVE these two functions and the matching `allow update` in /subscriptions before taking real money.
    // Real payments must be confirmed by a server (for example a Paystack webhook) that writes with admin rights.
    // Payment opens at the stored due date (the 28th), or at any time once the shop is overdue or deactivated.
    function paymentWindowOpen(before) {
      return before.get('status', 'active') == 'deactivated'
        || (before.get('dueDate', null) != null && request.time >= before.dueDate)
        || (before.get('accessUntil', null) != null && request.time >= before.accessUntil);
    }

    function validSimulatedPayment(before, after) {
      return after.diff(before).affectedKeys().hasOnly([
          'status', 'coveredMonth', 'dueDate', 'accessUntil',
          'lastPaymentAt', 'lastPaymentAmount', 'deactivatedReason', 'updatedAt'
        ])
        && after.status == 'active'
        && after.lastPaymentAmount == before.monthlyFee
        && after.lastPaymentAt == request.time
        && after.updatedAt == request.time
        && after.get('deactivatedReason', 'x') == ''
        && after.coveredMonth is string
        && after.coveredMonth.size() == 7
        && after.dueDate is timestamp
        && after.accessUntil is timestamp
        && after.dueDate > request.time
        && after.dueDate <= request.time + duration.value(36, 'd')
        && after.accessUntil > after.dueDate
        && after.accessUntil <= request.time + duration.value(36, 'd');
    }

    // ADMIN DOCUMENTS
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // SUBSCRIPTIONS AND BILLING
    match /subscriptions/{storeId} {
      allow get: if ownsStore(storeId) || isAdmin();
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        && validSubscription(storeId, request.resource.data);

      allow delete: if isAdmin();

      // DEMO ONLY: the shop pays its own subscription (simulated). See validSimulatedPayment above.
      allow update: if ownsStore(storeId)
        && paymentWindowOpen(resource.data)
        && validSimulatedPayment(resource.data, request.resource.data);

      // Payment history is append-only.
      // It cannot be edited or deleted.
      match /payments/{paymentId} {
        allow read: if ownsStore(storeId) || isAdmin();
        allow create: if isAdmin() && validPayment(request.resource.data);
        allow update, delete: if false;
      }
    }

    // SHOP STATISTICS
    match /shopStats/{storeId} {
      allow get: if ownsStore(storeId) || isAdmin();
      allow list: if isAdmin();

      allow create, update: if ownsStore(storeId)
        && validShopStats(storeId, request.resource.data);

      // UPDATED: admins can now delete shop statistics.
      allow delete: if ownsStore(storeId) || isAdmin();
    }

    // SHOP SCORES
    function validShopScore(storeId, d) {
      return d.keys().hasOnly([
          'storeId', 'score', 'tier', 'updatedAt'
        ])
        && d.keys().hasAll([
          'storeId', 'score', 'tier', 'updatedAt'
        ])
        && d.storeId == storeId
        && d.score is number
        && d.score >= 0
        && d.score <= 100
        && d.tier in ['high', 'mid', 'low']
        && d.updatedAt == request.time;
    }

    match /shopScores/{storeId} {
      allow get: if ownsStore(storeId) || isAdmin();
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        && validShopScore(storeId, request.resource.data);

      allow delete: if isAdmin();
    }

    // TEST COLLECTION
    match /test/{documentId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // USERS
    match /users/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.defaultStoreId == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'fullName', 'mobile', 'shopName',
          'defaultStoreId', 'createdAt', 'updatedAt', 'location', 'shopRegistration', 'province'
        ]);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.defaultStoreId == resource.data.defaultStoreId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'fullName', 'mobile', 'shopName',
          'defaultStoreId', 'createdAt', 'updatedAt', 'location', 'shopRegistration', 'province'
        ]);

      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    // STORES
    match /stores/{storeId} {
      allow read: if ownsStore(storeId) || isAdmin();

      allow create: if ownsStore(storeId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'seedVersion', 'createdAt', 'updatedAt'
        ]);

      allow update: if ownsStore(storeId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'seedVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if ownsStore(storeId);

      match /{collectionName}/{documentId} {
        allow read: if ownsStore(storeId);

        // Suspended shops cannot create new sales.
        allow create: if ownsStore(storeId)
          && request.resource.data.storeId == storeId
          && (collectionName != 'sales' || !isSuspended(storeId));

        allow update: if ownsStore(storeId)
          && resource.data.storeId == storeId
          && request.resource.data.storeId == storeId;

        allow delete: if ownsStore(storeId);
      }

      // Nested subcollections at any depth: read and delete only.
      match /{path=**} {
        allow read, delete: if ownsStore(storeId);
      }
    }
  }
}